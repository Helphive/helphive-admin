{
    "name": "helphive-admin",
    "private": true,
    "version": "2.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "deploy:cf": "npm run build && npx wrangler@4 deploy",
        "preview": "vite preview",
        "typecheck": "tsc -b",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
        "prepare": "husky"
    },
    "lint-staged": {
        "src/**/*.{ts,tsx}": [
            "prettier --write",
            "eslint --fix --max-warnings=0"
        ],
        "src/**/*.{css,json}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^6.5.0",
        "@phosphor-icons/react": "^2.1.10",
        "@reduxjs/toolkit": "^2.15.0",
        "@tanstack/react-table": "^8.21.3",
        "dayjs": "^1.11.23",
        "echarts": "^6.1.0",
        "leaflet": "^1.9.4",
        "qrcode.react": "^4.2.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-leaflet": "^4.2.1",
        "react-redux": "^9.3.1",
        "react-router-dom": "^7.18.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/leaflet": "^1.9.20",
        "@types/node": "^22.20.5",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react-swc": "^3.11.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "prettier": "^3.10.1",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.73.0",
        "vite": "^5.4.21"
    }
}
