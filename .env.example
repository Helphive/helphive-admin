# Base URL of the HelpHive API. The only variable the admin console reads.
# Local backend: VITE_APP_API_URL=http://localhost:8080
VITE_APP_API_URL=https://api.helphive.himaiz.com

# Production builds run on Cloudflare Workers Builds (every push to main); the production values are build
# variables on the helphive-admin Worker (Settings > Builds), not files in the repo.
